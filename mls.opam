# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Messaging Layer Security (RFC 9420) for OCaml"
description:
  "An implementation of the Messaging Layer Security protocol (RFC 9420): TLS presentation-language codec, ratchet tree (TreeKEM), key schedule, message framing and protection, and the group state machine. Cryptographic primitives are delegated to the hpke, mirage-crypto, and digestif packages."
maintainer: ["Ville Vesilehto <ville@vesilehto.fi>"]
authors: ["Ville Vesilehto <ville@vesilehto.fi>"]
license: "ISC"
tags: [
  "cryptography"
  "mls"
  "rfc9420"
  "messaging layer security"
  "end-to-end encryption"
]
homepage: "https://github.com/thevilledev/ocaml-mls"
bug-reports: "https://github.com/thevilledev/ocaml-mls/issues"
depends: [
  "dune" {>= "3.12"}
  "ocaml" {>= "4.14"}
  "hpke" {>= "0.1.1"}
  "mirage-crypto" {>= "2.4.0"}
  "mirage-crypto-ec" {>= "2.4.0"}
  "mirage-crypto-rng" {>= "2.4.0"}
  "kdf" {>= "1.1.0"}
  "digestif" {>= "1.3.1"}
  "eqaf" {>= "0.10"}
  "alcotest" {with-test & >= "1.7.0"}
  "yojson" {with-test & >= "2.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/thevilledev/ocaml-mls.git"
